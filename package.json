{
  "name": "jotter",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "A fast, minimal notepad with an autosaved drafts store, tabs, and markdown preview.",
  "author": "Byurhan Nurula (https://byurhannurula.com/)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/byurhannurula/jotter",
  "repository": {
    "type": "git",
    "url": "https://github.com/byurhannurula/jotter.git"
  },
  "bugs": {
    "url": "https://github.com/byurhannurula/jotter/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ship": "bash install.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "prepare": "husky",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "node e2e/run.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@wdio/cli": "9.31.5",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/tauri-service": "1.3.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "9.31.5"
  },
  "lint-staged": {
    "*.{js,css,html,json,md}": "prettier --write"
  },
  "keywords": [
    "notepad",
    "notes",
    "text-editor",
    "markdown",
    "scratchpad",
    "drafts",
    "tauri",
    "macos",
    "desktop-app"
  ]
}
